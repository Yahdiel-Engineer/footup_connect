{
  "expo": {
    "name": "FootUP",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "footup",
    "android": {
      "package": "com.drillergram.footup",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l'accès à vos photos."
        }
      ],
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "FootUp utilise le Bluetooth pour se connecter à tes cibles et recevoir tes frappes."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#FF1744",
          "defaultChannel": "messages"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b3aae55-8a60-44ba-8d8c-e9c25ac27682"
      }
    },
    "owner": "drillergram",
    "ios": {
      "bundleIdentifier": "com.drillergram.footup",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "FootUp utilise le Bluetooth pour se connecter à tes cibles et recevoir tes frappes."
      }
    }
  }
}
