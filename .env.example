# Copier en .env (ne pas commiter .env). Ces valeurs sont intégrées à l'app : rien de secret ici.

# URL PUBLIQUE de l'API (https://xxx.up.railway.app), pas l'adresse .railway.internal
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
# Clé PUBLIQUE Supabase (sb_publishable_...), jamais la clé secrète
EXPO_PUBLIC_SUPABASE_KEY=
